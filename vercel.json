{
  "framework": "nextjs",
  "functions": {
    "api/generate.js": {
      "maxDuration": 60
    },
    "api/generate-prompt.js": {
      "maxDuration": 30
    },
    "api/explain-line-by-line.js": {
      "maxDuration": 60
    },
    "api/convert-code.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/snippet/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}